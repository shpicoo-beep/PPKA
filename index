    async function deleteStudentAccount(npm) {
      if (!confirm(`Hapus akun mahasiswa NPM ${npm}? Seluruh data mahasiswa ini akan dihapus.`)) return;
      await dbDelete('users', npm);
      showToast(`Akun NPM ${npm} telah dihapus.`, 'info');
      await populateAdminStudentSelect();
      openUserManagementModal();
      renderPresensiToday();
      renderPresensiList();
      renderLogbookList();
      renderResumeList();
      renderKelolaanList();
    }

