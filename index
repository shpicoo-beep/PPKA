    function toggleExportPeriodInputs() {
      const p = $('exportPeriodType').value;
      if (p === 'daily') {
        $('groupExportDaily').classList.remove('hidden');
        $('groupExportWeekly').classList.add('hidden');
      } else if (p === 'weekly') {
        $('groupExportDaily').classList.add('hidden');
        $('groupExportWeekly').classList.remove('hidden');
      } else {
        $('groupExportDaily').classList.add('hidden');
        $('groupExportWeekly').classList.add('hidden');
      }
    }

    async function getFilteredDataForExport() {
      const reportType = $('exportReportType').value; // 'ALL', 'presensi', 'logbook', 'resume', 'kelolaan'
      const periodType = $('exportPeriodType').value; // 'all', 'daily', 'weekly'
      const dailyDate = $('exportDailyDate').value;
      const weeklyStartDate = $('exportWeeklyStartDate').value;
      const activeNPM = getActiveNPM();

      let targetStudent = null;
      if (activeNPM) {
        targetStudent = await dbGet('users', activeNPM);
      }

      // Calculate date boundary
      let minDate = '', maxDate = '';
      if (periodType === 'daily') {
        minDate = dailyDate;
        maxDate = dailyDate;
      } else if (periodType === 'weekly') {
        minDate = weeklyStartDate;
        if (weeklyStartDate) {
          const d = new Date(weeklyStartDate);
          d.setDate(d.getDate() + 6);
          maxDate = d.toISOString().split('T')[0];
        }
      }

      const matchPeriod = (dateStr) => {
        if (periodType === 'all') return true;
        if (!dateStr) return false;
        if (minDate && dateStr < minDate) return false;
        if (maxDate && dateStr > maxDate) return false;
        return true;
      };

      const filterByStudent = (arr) => {
        if (!activeNPM) return arr;
        return arr.filter(x => x.npm === activeNPM);
      };

      const result = {
        metadata: {
          app: 'KepAn Profesi Keperawatan Anak',
          generatedAt: new Date().toISOString(),
          reportType,
          periodType,
          periodRange: periodType === 'all' ? 'Seluruh Data Lengkap' : `${minDate} s/d ${maxDate}`,
          student: targetStudent || { name: 'Semua Mahasiswa', npm: 'ALL' }
        },
        presensi: [],
        logbook: [],
        resume: [],
        kelolaan: []
      };

      if (reportType === 'ALL' || reportType === 'presensi') {
        const pres = await dbGetAll('presensi');
        result.presensi = filterByStudent(pres).filter(r => matchPeriod(r.date));
      }
      if (reportType === 'ALL' || reportType === 'logbook') {
        const logs = await dbGetAll('logbook');
        result.logbook = filterByStudent(logs).filter(r => matchPeriod(r.date));
      }
      if (reportType === 'ALL' || reportType === 'resume') {
        const res = await dbGetAll('resume');
        result.resume = filterByStudent(res).filter(r => matchPeriod(r.date));
      }
      if (reportType === 'ALL' || reportType === 'kelolaan') {
        const kel = await dbGetAll('kelolaan');
        result.kelolaan = filterByStudent(kel).filter(r => matchPeriod(r.date));
      }

      return result;
    }

    async function triggerExport(format) {
      const data = await getFilteredDataForExport();

      const totalItems = data.presensi.length + data.logbook.length + data.resume.length + data.kelolaan.length;
      if (totalItems === 0) {
        showToast('Tidak ada data pada periode/kategori yang dipilih.', 'error');
        return;
      }

      const dateTag = data.metadata.periodType === 'all' ? 'LENGKAP' : data.metadata.periodRange.replace(/[^a-zA-Z0-9]/g, '_');
      const filenameBase = `KepAn_${data.metadata.student.npm}_${data.metadata.reportType}_${dateTag}`;

      if (format === 'json') {
        exportAsJSON(data, `${filenameBase}.json`);
      } else if (format === 'csv') {
        exportAsCSV(data, `${filenameBase}.csv`);
      } else if (format === 'pdf') {
        exportAsPDF(data);
      }
    }

    // JSON Export
    function exportAsJSON(data, filename) {
      const jsonStr = JSON.stringify(data, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8;' });
      downloadBlob(blob, filename);
      showToast('Berkas JSON berhasil diunduh.', 'success');
    }

    // CSV Export
    function exportAsCSV(data, filename) {
      let csvContent = '\uFEFF'; // UTF-8 BOM for Excel compatibility

      const escCSV = (str) => `"${String(str ?? '').replace(/"/g, '""').replace(/\r?\n/g, ' ')}"`;

      // 1. Presensi CSV
      if (data.presensi.length > 0) {
        csvContent += '=== LAPORAN PRESENSI MAHASISWA ===\n';
        csvContent += ['NPM', 'Nama Mahasiswa', 'Tanggal', 'Jam Datang', 'Jam Pulang', 'Catatan', 'Foto Datang', 'Foto Pulang'].map(escCSV).join(',') + '\n';
        data.presensi.forEach(r => {
          csvContent += [
            r.npm,
            r.studentName || '-',
            r.date,
            r.timeCome || '-',
            r.timeLeave || '-',
            r.notes || '-',
            r.photoCome ? 'TERLAMPIR' : '-',
            r.photoLeave ? 'TERLAMPIR' : '-'
          ].map(escCSV).join(',') + '\n';
        });
        csvContent += '\n';
      }

      // 2. Logbook CSV
      if (data.logbook.length > 0) {
        csvContent += '=== LAPORAN LOG BOOK HARIAN ===\n';
        csvContent += ['NPM', 'Nama Mahasiswa', 'Tanggal', 'Jam', 'Jenis Kegiatan', 'Deskripsi Lengkap', 'Bukti Foto'].map(escCSV).join(',') + '\n';
        data.logbook.forEach(r => {
          csvContent += [
            r.npm,
            r.studentName || '-',
            r.date,
            r.time,
            r.activityType,
            r.description,
            r.evidencePhoto ? 'TERLAMPIR' : '-'
          ].map(escCSV).join(',') + '\n';
        });
        csvContent += '\n';
      }

      // 3. Resume Askep CSV
      if (data.resume.length > 0) {
        csvContent += '=== LAPORAN RESUME ASUHAN KEPERAWATAN ===\n';
        csvContent += ['NPM', 'Nama Mahasiswa', 'Tanggal', 'Inisial Klien', 'Usia', 'Jenis Kelamin', 'TB (cm)', 'BB (kg)', 'Keluhan Utama', 'Pengkajian', 'Intervensi', 'Implementasi', 'Evaluasi SOAP'].map(escCSV).join(',') + '\n';
        data.resume.forEach(r => {
          csvContent += [
            r.npm,
            r.studentName || '-',
            r.date,
            r.clientInitial,
            r.clientAge || '-',
            r.clientGender,
            r.clientHeight,
            r.clientWeight,
            r.chiefComplaint,
            r.assessment,
            r.intervention,
            r.implementation,
            r.evaluation
          ].map(escCSV).join(',') + '\n';
        });
        csvContent += '\n';
      }

      // 4. Kelolaan CSV
      if (data.kelolaan.length > 0) {
        csvContent += '=== LAPORAN KASUS KELOLAAN ===\n';
        csvContent += ['NPM', 'Nama Mahasiswa', 'Tanggal', 'Inisial Klien', 'Usia', 'Jenis Kelamin', 'TB (cm)', 'BB (kg)', 'Keluhan Utama', 'Pengkajian Mendalam', 'Intervensi', 'Implementasi', 'Evaluasi SOAP'].map(escCSV).join(',') + '\n';
        data.kelolaan.forEach(r => {
          csvContent += [
            r.npm,
            r.studentName || '-',
            r.date,
            r.clientInitial,
            r.clientAge || '-',
            r.clientGender,
            r.clientHeight,
            r.clientWeight,
            r.chiefComplaint,
            r.assessment,
            r.intervention,
            r.implementation,
            r.evaluation
          ].map(escCSV).join(',') + '\n';
        });
        csvContent += '\n';
      }

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      downloadBlob(blob, filename);
      showToast('Berkas CSV berhasil diunduh.', 'success');
    }

