  <script>
    /* =====================================================================
       DATABASE LAYER (IndexedDB)
       Provides massive offline storage without localStorage 5MB quota errors!
       ===================================================================== */
    const DB_NAME = 'KepAnProfesi_DB';
    const DB_VERSION = 1;
    let dbInstance = null;

    function openDatabase() {
      return new Promise((resolve, reject) => {
        if (dbInstance) return resolve(dbInstance);
        const req = indexedDB.open(DB_NAME, DB_VERSION);

        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          // Store 1: Users (Key: npm)
          if (!db.objectStoreNames.contains('users')) {
            const userStore = db.createObjectStore('users', { keyPath: 'npm' });
            userStore.createIndex('name', 'name', { unique: false });
          }
          // Store 2: Presensi (Key: id)
          if (!db.objectStoreNames.contains('presensi')) {
            const presStore = db.createObjectStore('presensi', { keyPath: 'id' });
            presStore.createIndex('npm', 'npm', { unique: false });
            presStore.createIndex('date', 'date', { unique: false });
          }
          // Store 3: Logbook (Key: id)
          if (!db.objectStoreNames.contains('logbook')) {
            const logStore = db.createObjectStore('logbook', { keyPath: 'id' });
            logStore.createIndex('npm', 'npm', { unique: false });
            logStore.createIndex('date', 'date', { unique: false });
          }
          // Store 4: Resume Askep (Key: id)
          if (!db.objectStoreNames.contains('resume')) {
            const resumeStore = db.createObjectStore('resume', { keyPath: 'id' });
            resumeStore.createIndex('npm', 'npm', { unique: false });
            resumeStore.createIndex('date', 'date', { unique: false });
          }
          // Store 5: Laporan Kelolaan (Key: id)
          if (!db.objectStoreNames.contains('kelolaan')) {
            const kelolaanStore = db.createObjectStore('kelolaan', { keyPath: 'id' });
            kelolaanStore.createIndex('npm', 'npm', { unique: false });
            kelolaanStore.createIndex('date', 'date', { unique: false });
          }
          // Store 6: App State / Session
          if (!db.objectStoreNames.contains('meta')) {
            db.createObjectStore('meta', { keyPath: 'key' });
          }
        };

        req.onsuccess = (e) => {
          dbInstance = e.target.result;
          resolve(dbInstance);
        };
        req.onerror = (e) => reject(e.target.error);
      });
    }

    // Generic DB Helpers
    async function dbGetAll(storeName) {
      const db = await openDatabase();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(storeName, 'readonly');
        const store = tx.objectStore(storeName);
        const req = store.getAll();
        req.onsuccess = () => resolve(req.result || []);
        req.onerror = () => reject(req.error);
      });
    }

    async function dbGet(storeName, key) {
      const db = await openDatabase();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(storeName, 'readonly');
        const store = tx.objectStore(storeName);
        const req = store.get(key);
        req.onsuccess = () => resolve(req.result || null);
        req.onerror = () => reject(req.error);
      });
    }

    async function dbPut(storeName, value) {
      const db = await openDatabase();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(storeName, 'readwrite');
        const store = tx.objectStore(storeName);
        store.put(value);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => reject(tx.error);
      });
    }

    async function dbDelete(storeName, key) {
      const db = await openDatabase();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(storeName, 'readwrite');
        const store = tx.objectStore(storeName);
        store.delete(key);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => reject(tx.error);
      });
    }

