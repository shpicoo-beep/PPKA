       ===================================================================== */
    let tempSelfieData = { come: null, leave: null };

    async function startSelfieCamera(type) {
      const video = $(type === 'come' ? 'videoCome' : 'videoLeave');
      const placeholder = $(type === 'come' ? 'placeholderCome' : 'placeholderLeave');
      const btnOpen = $(type === 'come' ? 'btnOpenCamCome' : 'btnOpenCamLeave');
      const btnSnap = $(type === 'come' ? 'btnSnapCamCome' : 'btnSnapCamLeave');
      const btnClose = $(type === 'come' ? 'btnCloseCamCome' : 'btnCloseCamLeave');
      const imgPrev = $(type === 'come' ? 'imgPreviewCome' : 'imgPreviewLeave');

      stopSelfieCamera(type);

      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          throw new Error('Kamera tidak didukung oleh browser Anda.');
        }

        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false
        });

        activeCameraStream = stream;
        video.srcObject = stream;
        video.classList.remove('hidden');
        placeholder.classList.add('hidden');
        imgPrev.classList.add('hidden');

        btnOpen.classList.add('hidden');
        btnSnap.classList.remove('hidden');
        btnClose.classList.remove('hidden');
      } catch (err) {
        showToast('Tidak dapat membuka kamera langsung. Silakan gunakan tombol "Unggah".', 'error');
      }
    }

    function snapSelfiePhoto(type) {
      const video = $(type === 'come' ? 'videoCome' : 'videoLeave');
      const imgPrev = $(type === 'come' ? 'imgPreviewCome' : 'imgPreviewLeave');
      const now = new Date();
      const timeStr = now.toLocaleTimeString('id-ID') + ' WIB';

      const canvas = $('processingCanvas');
      canvas.width = video.videoWidth || 480;
      canvas.height = video.videoHeight || 480;
      const ctx = canvas.getContext('2d');

      // Mirror canvas for selfie
      ctx.translate(canvas.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      // Watermark with timestamp on photo
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(0, canvas.height - 28, canvas.width, 28);
      ctx.font = '13px sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(`${now.toLocaleDateString('id-ID')} • ${timeStr}`, 10, canvas.height - 9);

      const photoData = canvas.toDataURL('image/jpeg', 0.82);
      tempSelfieData[type] = { photo: photoData, time: timeStr, timestamp: now.getTime() };

      imgPrev.src = photoData;
      imgPrev.classList.remove('hidden');
      video.classList.add('hidden');

      stopSelfieCamera(type);

      const infoBoxText = $(type === 'come' ? 'timestampTextCome' : 'timestampTextLeave');
      infoBoxText.innerHTML = `✅ Foto selfie diambil: <b>${timeStr}</b>. Klik tombol Simpan di bawah.`;
    }

    async function handleSelfieUpload(e, type) {
      const file = e.target.files[0];
      if (!file) return;
      const now = new Date();
      const timeStr = now.toLocaleTimeString('id-ID') + ' WIB';

      const compressed = await compressImage(file, 640, 0.8);
      tempSelfieData[type] = { photo: compressed, time: timeStr, timestamp: now.getTime() };

      const imgPrev = $(type === 'come' ? 'imgPreviewCome' : 'imgPreviewLeave');
      const placeholder = $(type === 'come' ? 'placeholderCome' : 'placeholderLeave');
      imgPrev.src = compressed;
      imgPrev.classList.remove('hidden');
      placeholder.classList.add('hidden');

      const infoBoxText = $(type === 'come' ? 'timestampTextCome' : 'timestampTextLeave');
      infoBoxText.innerHTML = `✅ Foto selfie diunggah: <b>${timeStr}</b>. Klik tombol Simpan di bawah.`;
    }

    function stopSelfieCamera(type) {
      if (activeCameraStream) {
        activeCameraStream.getTracks().forEach(t => t.stop());
        activeCameraStream = null;
      }
      const video = $(type === 'come' ? 'videoCome' : 'videoLeave');
      const btnOpen = $(type === 'come' ? 'btnOpenCamCome' : 'btnOpenCamLeave');
      const btnSnap = $(type === 'come' ? 'btnSnapCamCome' : 'btnSnapCamLeave');
      const btnClose = $(type === 'come' ? 'btnCloseCamCome' : 'btnCloseCamLeave');

      video.classList.add('hidden');
      btnOpen.classList.remove('hidden');
      btnSnap.classList.add('hidden');
      btnClose.classList.add('hidden');
    }

    // Universal Direct Camera modal
    function openDirectCamera(target) {
      universalCameraTarget = target;
      openModal('universalCameraModal');
      const video = $('universalVideo');
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
        .then(stream => {
          activeCameraStream = stream;
          video.srcObject = stream;
        })
        .catch(() => {
          navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
              activeCameraStream = stream;
              video.srcObject = stream;
            })
            .catch(() => {
              showToast('Tidak dapat membuka kamera langsung.', 'error');
              closeUniversalCamera();
            });
        });
    }

    function snapUniversalPhoto() {
      const video = $('universalVideo');
      const canvas = $('processingCanvas');
      canvas.width = video.videoWidth || 640;
      canvas.height = video.videoHeight || 480;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
