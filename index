    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        URL.revokeObjectURL(url);
        a.remove();
      }, 800);
    }

    // JSON Import / Restore
    async function handleImportJSON(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async () => {
        try {
          const imported = JSON.parse(reader.result);
          if (!imported || typeof imported !== 'object') {
            throw new Error('Format JSON tidak valid.');
          }

          let count = 0;
          if (Array.isArray(imported.presensi)) {
            for (const p of imported.presensi) { await dbPut('presensi', p); count++; }
          }
          if (Array.isArray(imported.logbook)) {
            for (const l of imported.logbook) { await dbPut('logbook', l); count++; }
          }
          if (Array.isArray(imported.resume)) {
            for (const r of imported.resume) { await dbPut('resume', r); count++; }
          }
          if (Array.isArray(imported.kelolaan)) {
            for (const k of imported.kelolaan) { await dbPut('kelolaan', k); count++; }
          }

          showToast(`Berhasil memulihkan ${count} data dari file cadangan!`, 'success');
          renderPresensiToday();
          renderPresensiList();
          renderLogbookList();
          renderResumeList();
          renderKelolaanList();
        } catch (err) {
          showToast(`Gagal mengimpor file: ${err.message}`, 'error');
        }
      };
      reader.readAsText(file);
    }

