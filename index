    // Calculate age helper
    function calcAge(dobString, targetInputId) {
      if (!dobString) return;
      const dob = new Date(dobString);
      const now = new Date();
      if (isNaN(dob.getTime())) return;

      let years = now.getFullYear() - dob.getFullYear();
      let months = now.getMonth() - dob.getMonth();
      let days = now.getDate() - dob.getDate();

      if (days < 0) {
        months--;
      }
      if (months < 0) {
        years--;
        months += 12;
      }

      let ageStr = '';
      if (years > 0) {
        ageStr = `${years} tahun ${months > 0 ? months + ' bulan' : ''}`.trim();
      } else if (months > 0) {
        ageStr = `${months} bulan`;
      } else {
        const diffDays = Math.max(1, Math.floor((now - dob) / (1000 * 60 * 60 * 24)));
        ageStr = `${diffDays} hari`;
      }
      if ($(targetInputId)) $(targetInputId).value = ageStr;
    }

