                  <option value="Pengkajian Tumbuh Kembang & Antropometri (SDIDTK/KPSP)">Pengkajian Tumbuh Kembang & Antropometri (SDIDTK/KPSP)</option>
                  <option value="Pemberian Terapi Obat / Injeksi Aman Pada Anak">Pemberian Terapi Obat / Injeksi Aman Pada Anak</option>
                  <option value="Manajemen Cairan & Rehidrasi (Diare / Dehidrasi MTBS)">Manajemen Cairan & Rehidrasi (Diare / Dehidrasi MTBS)</option>
                  <option value="Perawatan Bayi Baru Lahir / BBLR / Fototerapi">Perawatan Bayi Baru Lahir / BBLR / Fototerapi</option>
                  <option value="Pemantauan Tanda Vital & Pediatric Early Warning (PEWS)">Pemantauan Tanda Vital & Pediatric Early Warning (PEWS)</option>
                  <option value="Edukasi & Health Education Orang Tua / Imunisasi">Edukasi & Health Education Orang Tua / Imunisasi</option>
                  <option value="Ronde Keperawatan / Diskusi Refleksi Kasus Klinis">Ronde Keperawatan / Diskusi Refleksi Kasus Klinis</option>
                  <option value="Lainnya">Lainnya (Ketik Manual)</option>
